{
  "name": "copilotview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse, search and summarize past GitHub Copilot CLI sessions stored in ~/.copilot/session-state",
  "license": "MIT",
  "bin": {
    "copilotview": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "vite build",
    "dev:web": "vite",
    "index": "tsx src/cli.ts index",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src web tests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.6.14",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.2"
  }
}
