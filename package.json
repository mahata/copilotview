{
  "name": "copilotview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browse, search and summarize past GitHub Copilot CLI and app sessions stored in ~/.copilot/session-state",
  "license": "MIT",
  "bin": {
    "copilotview": "./dist/cli.js",
    "cv": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "vite build",
    "package": "node scripts/package-release.mjs",
    "dev:web": "vite",
    "index": "tsx src/cli.ts index",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src web tests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.6.14",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
